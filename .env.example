# Copy to .env. Do not put secrets in frontend files.
PORT=3100
DB_HOST=homework_mysql_prod
DB_PORT=3306
DB_NAME=homework_assistant
DB_USER=homework_assistant
DB_PASSWORD=
PARENT_PASSWORD=
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.5
DATA_DIR=./data
# Existing MySQL container's Docker network (see README)
MYSQL_NETWORK=proj_source_homework_network
# HTTP behind existing HTTPS reverse proxy; bind only loopback by default
HTTP_BIND=127.0.0.1
HTTP_PORT=52880
# Used only when deploy/compose.https.yaml is copied to compose.override.yaml
HTTPS_DOMAIN=homework.beetron.cn
