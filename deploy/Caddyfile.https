(homework) {
  encode gzip zstd
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options SAMEORIGIN
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
  }
  handle /api/* {
    reverse_proxy api:3100
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}

https://{$HTTPS_DOMAIN} {
  import homework
}

# Preserve the existing loopback-only HTTP health-check entry point.
http://127.0.0.1, http://localhost {
  import homework
}
