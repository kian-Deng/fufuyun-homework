<view class="page" wx:if="{{job}}"><view class="title">核对一下，再发布</view><view class="sub">所属日期 {{job.work_date}} · 科目、页码、题号请以原消息为准。</view><view class="card"><view class="heading">原始消息</view><view class="content">{{job.source_text || '本次来自截图，请对照手机原图核对。'}}</view><view class="muted" wx:for="{{job.attachments}}" wx:key="id">附件：{{item.name}}</view></view><view wx:if="{{job.error}}" class="warning">{{job.error}}</view><block wx:if="{{job.status==='review'||job.status==='failed'}}"><view class="warning" wx:for="{{job.result.notices}}" wx:key="*this">通知（不作为作业发布）：{{item}}</view><view wx:for="{{job.result.items}}" wx:key="index" class="card"><view class="label">科目</view><input value="{{item.subject}}" maxlength="30" data-index="{{index}}" data-field="subject" bindinput="input"/><view class="label">作业要求</view><textarea value="{{item.content}}" maxlength="3000" data-index="{{index}}" data-field="content" bindinput="input"/><view class="label">截止日期（可留空）</view><input value="{{item.dueDate}}" placeholder="YYYY-MM-DD" data-index="{{index}}" data-field="dueDate" bindinput="input"/><view class="label">准备材料</view><input value="{{item.materials}}" maxlength="500" data-index="{{index}}" data-field="materials" bindinput="input"/><view wx:if="{{item.warning}}" class="warning">待确认：{{item.warning}}</view><button data-index="{{index}}" bindtap="remove">删除这一项</button></view><button bindtap="add">添加作业</button><button wx:if="{{job.status==='failed'}}" bindtap="retry" disabled="{{busy}}">重新分析</button><button bindtap="saveClick" disabled="{{busy}}">保存草稿</button><button class="primary" bindtap="publish" loading="{{busy}}" disabled="{{busy||!job.result.items.length}}">保存并发布给孩子</button></block><block wx:elif="{{job.status==='published'}}"><view class="card">已发布。个别作业编辑可在网页家长端操作。</view><button bindtap="withdraw" disabled="{{busy}}">撤回整批重新审核</button></block><view wx:else class="card">正在等待 Kimi 分析，结果会自动刷新。</view></view>
