<view class="page dock-page"><view class="heading">家庭任务清单</view><view class="muted">维护日常要求，再按日期分配给孩子。</view><view wx:if="{{notice}}" class="warning">{{notice}}</view>
 <view class="card"><view class="heading">{{editing?'修改清单任务':'新增清单任务'}}</view><textarea value="{{content}}" maxlength="3000" bindinput="input" placeholder="例如：弹钢琴20分钟"/><view class="row"><view>优先任务</view><switch checked="{{priority}}" bindchange="priority"/></view><button class="primary" bindtap="save" disabled="{{busy||!content}}">保存到清单</button><button wx:if="{{editing}}" bindtap="reset" disabled="{{busy}}">取消修改</button></view>
 <view class="card"><view class="heading">选择要分配的任务</view><view wx:if="{{!tasks.length}}" class="muted">请先新增家庭任务。</view><checkbox-group bindchange="taskChange"><view wx:for="{{tasks}}" wx:key="id"><label class="check"><checkbox value="{{item.id}}" checked="{{taskFlags[item.id] || false}}" disabled="{{busy}}"/><text class="household-description">{{item.content}}</text></label><view class="task-actions"><button data-index="{{index}}" bindtap="edit" disabled="{{busy}}">修改</button><button data-index="{{index}}" bindtap="remove" disabled="{{busy}}">移除</button></view></view></checkbox-group></view>
 <view class="card"><view class="heading">分配到日期</view><view class="label">选择孩子</view><checkbox-group bindchange="childChange"><label wx:for="{{children}}" wx:key="id" class="check"><checkbox value="{{item.id}}" disabled="{{busy}}"/>{{item.name}}</label></checkbox-group><view class="row"><view>开始日期</view><picker mode="date" value="{{startDate}}" data-field="startDate" bindchange="dateChange"><view>{{startDate}} ▾</view></picker></view><view class="row"><view>结束日期</view><picker mode="date" value="{{endDate}}" start="{{startDate}}" data-field="endDate" bindchange="dateChange"><view>{{endDate}} ▾</view></picker></view><view class="label">每周执行日期</view><checkbox-group bindchange="weekChange"><label wx:for="{{week}}" wx:key="id" class="check"><checkbox value="{{item.id}}" checked="{{weekFlags[item.id] || false}}" disabled="{{busy}}"/>周{{item.name}}</label></checkbox-group><view class="muted">预计{{preview}}项。重复分配跳过已有任务；修改、移除清单不会改动已分配任务。孩子端到对应日期显示，过期未完成仍保留。</view></view>
 <view class="bottom-dock"><button class="primary" bindtap="assign" disabled="{{busy||!preview||preview>2000}}">分配到日期（{{preview}}项）</button></view>
</view>
