<page-meta page-style="{{sheet?'overflow:hidden;':''}}"/>
<view class="page dock-page">
 <view class="hh-tabs"><button class="{{tab==='published'?'hh-active':''}}" data-tab="published" bindtap="tab" disabled="{{busy}}">任务发布清单</button><button class="{{tab==='library'?'hh-active':''}}" data-tab="library" bindtap="tab" disabled="{{busy}}">任务清单</button></view>
 <view wx:if="{{notice}}" class="hh-toast">{{notice}}</view>
 <view wx:if="{{tab==='published'}}" class="hh-tab-content"><view wx:if="{{!publications.length}}" class="empty">{{busy?'正在加载…':'还没有发布的家庭任务'}}<button wx:if="{{!busy}}" bindtap="goLibrary">去任务清单新增</button></view><view wx:for="{{publications}}" wx:key="id" class="card compact-card"><view class="row"><view class="heading">{{item.childName}}</view><view class="badge">{{item.status}}</view></view><view wx:for="{{item.tasks}}" wx:for-item="task" wx:key="*this" class="household-description">{{task}}</view><view class="muted">分配于 {{item.assignedText}}</view><view class="muted">执行 {{item.startDate}} {{item.endDate&&item.endDate!==item.startDate?'至 '+item.endDate:''}}</view><view class="muted">{{item.ruleText}}</view><view class="muted">已完成 {{item.completed}} / {{item.total}} {{item.removed?'· 已移除'+item.removed+'项':''}}</view></view><button wx:if="{{nextOffset!==null}}" bindtap="more" disabled="{{busy}}">加载更多</button></view>
 <view wx:else class="hh-tab-content"><view wx:if="{{!tasks.length}}" class="empty">{{busy?'正在加载…':'清单为空，点击底部新增任务'}}</view><checkbox-group bindchange="taskChange"><view wx:for="{{tasks}}" wx:key="id" class="card compact-card"><label class="check hh-task-select"><checkbox value="{{item.id}}" checked="{{taskFlags[item.id] || false}}" disabled="{{busy}}"/><text class="household-description">{{item.content}}</text></label><view class="task-actions"><button data-index="{{index}}" bindtap="openPublish" disabled="{{busy}}">发布</button><button data-index="{{index}}" bindtap="edit" disabled="{{busy}}">编辑</button><button data-index="{{index}}" bindtap="askRemove" disabled="{{busy}}">移除</button></view></view></checkbox-group><view wx:if="{{!sheet}}" class="bottom-dock"><button bindtap="newTask" disabled="{{busy}}">新增任务</button><button class="primary" bindtap="openPublish" disabled="{{busy||!taskIds.length}}">发布所选（{{taskIds.length}}）</button></view></view>
 <view wx:if="{{sheet}}" class="hh-mask {{closing?'hh-closing':''}}" bindtap="close" style="bottom:{{keyboard}}px"><view class="hh-sheet" catchtap="noop"><view class="row"><view class="heading">{{sheet==='edit'?(editing?'编辑任务':'新增任务'):sheet==='assign'?'发布任务':'移除任务'}}</view><button bindtap="close" disabled="{{busy}}">关闭</button></view>
 <scroll-view scroll-y class="hh-sheet-scroll" style="height:{{sheet==='remove'?'180rpx':'60vh'}}"><block wx:if="{{sheet==='edit'}}"><view class="label">任务要求</view><textarea value="{{content}}" maxlength="3000" bindinput="input" placeholder="例如：弹钢琴20分钟"/><view class="row"><view>优先任务</view><switch checked="{{priority}}" bindchange="priority"/></view></block>
 <block wx:elif="{{sheet==='assign'}}"><view class="muted">已选{{taskIds.length}}项任务</view><view class="label">分配给</view><checkbox-group bindchange="childChange"><label wx:for="{{children}}" wx:key="id" class="check"><checkbox value="{{item.id}}" checked="{{childFlags[item.id] || false}}" disabled="{{busy}}"/>{{item.name}}</label></checkbox-group><view class="hh-tabs"><button class="{{mode==='range'?'hh-active':''}}" data-mode="range" bindtap="mode" disabled="{{busy}}">按周期</button><button class="{{mode==='weekly'?'hh-active':''}}" data-mode="weekly" bindtap="mode" disabled="{{busy}}">按每周</button></view><view class="row"><view>开始日期</view><picker mode="date" value="{{startDate}}" data-field="startDate" bindchange="dateChange"><view>{{startDate}} ▾</view></picker></view><block wx:if="{{mode==='range'}}"><view class="row"><view>结束日期</view><picker mode="date" value="{{endDate}}" start="{{startDate}}" data-field="endDate" bindchange="dateChange"><view>{{endDate}} ▾</view></picker></view><view class="muted">起止日期内每天执行。</view></block><block wx:else><view class="label">执行周数（1–52）</view><input type="number" value="{{weeks}}" bindinput="weeksInput"/><view class="label">每周星期</view><checkbox-group bindchange="weekChange"><label wx:for="{{week}}" wx:key="id" class="check"><checkbox value="{{item.id}}" checked="{{weekFlags[item.id] || false}}" disabled="{{busy}}"/>周{{item.name}}</label></checkbox-group></block><view class="muted">预计{{preview}}项；已有任务自动跳过。</view></block>
 <view wx:else class="muted">从任务清单移除？已发布任务和完成记录保留。</view></scroll-view>
 <view class="hh-sheet-actions"><button wx:if="{{sheet==='edit'}}" class="primary" bindtap="save" disabled="{{busy||!content}}">保存到任务清单</button><button wx:elif="{{sheet==='assign'}}" class="primary" bindtap="assign" disabled="{{busy||!preview||preview>2000}}">{{busy?'发布中…':'确认发布（'+preview+'项）'}}</button><button wx:else class="primary" bindtap="remove" disabled="{{busy}}">确认移除</button></view>
 </view></view>
</view>