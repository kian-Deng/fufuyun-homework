<view class="page dock-page">
<block wx:if="{{!edit}}">
 <view class="row compact-top"><picker range="{{children}}" range-key="name" value="{{index}}" bindchange="child"><view>{{children[index].name || '请添加孩子'}} ▾</view></picker><picker mode="date" value="{{date}}" bindchange="dateChange"><view>{{date}}</view></picker><view class="link" bindtap="more">更多</view></view>
 <view class="card compact-card"><view class="mode-tabs"><button class="{{!useAI?'primary':''}}" data-ai="false" bindtap="mode">直接录入</button><button class="{{useAI?'primary':''}}" data-ai="true" bindtap="mode">Kimi 整理</button></view><textarea value="{{text}}" bindinput="textInput" bindkeyboardheightchange="keyboardChange" bindblur="blur" adjust-position="{{false}}" maxlength="50000" placeholder="{{useAI?'粘贴老师消息，或添加截图、文件':'粘贴已整理的作业，每行或每个编号一项'}}"/><view wx:if="{{children.length>1}}" class="link" bindtap="expand">分配孩子（{{childIds.length}}） {{expanded?'收起':'展开'}}</view><checkbox-group wx:if="{{expanded}}" bindchange="childChange"><label wx:for="{{children}}" wx:key="id" class="check"><checkbox value="{{item.id}}" checked="{{childFlags[item.id] || false}}" color="#315f53"/>{{item.name}}</label></checkbox-group><block wx:if="{{useAI}}"><view class="row"><button bindtap="images" disabled="{{files.length>=5}}">添加截图</button><button bindtap="files" disabled="{{files.length>=5}}">从微信聊天选择文件</button></view><view wx:for="{{files}}" wx:key="path" class="row"><text class="file-name">{{item.name}}</text><text class="link" data-index="{{index}}" bindtap="removeFile">移除</text></view><view class="muted">最多5个文件，每个8MB；支持图片、TXT、JSON。内容将发给 Kimi。</view></block></view>
 <view wx:if="{{current}}" class="row"><view>{{current.label}}</view><view class="link" bindtap="review">查看结果</view></view>
 <view class="row"><view class="heading">已有作业 {{assignments.length}}</view><view class="row"><view class="muted">所有未完成</view><switch checked="{{pending}}" bindchange="pendingChange" color="#315f53"/></view></view>
 <view wx:if="{{!assignments.length}}" class="empty">暂无作业，在上方录入后发布。</view>
 <view wx:for="{{assignments}}" wx:key="id" class="card compact-card"><view class="badge">{{item.subject}} {{item.priority==='high'?'· 优先':''}}</view><view wx:if="{{item.updated}}" class="warning">内容有更新</view><view class="content {{item.completed?'complete':''}}">{{item.content}}</view><view wx:if="{{item.materials}}" class="muted">准备：{{item.materials}}</view><view class="muted">{{item.completed?'已完成':'待完成'}} {{item.due_date?'· 截止 '+item.due_date:''}}</view><view class="task-actions"><button data-index="{{index}}" bindtap="toggle" disabled="{{busy}}">{{item.completed?'取消完成':'标记完成'}}</button><button data-index="{{index}}" bindtap="editTask" disabled="{{busy}}">详情 / 编辑</button><button data-index="{{index}}" bindtap="remove" disabled="{{busy}}">删除</button></view></view>
 <view class="bottom-dock" style="bottom:{{keyboard}}px"><button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy||!childIds.length||(!hasText&&(!useAI||!files.length))}}">{{useAI?'交给 Kimi 整理':'预览任务'}}</button></view>
</block>
<block wx:else><view class="row"><view class="heading">编辑作业</view><view class="link" bindtap="closeEdit">关闭</view></view><view class="card"><view class="label">学科</view><input value="{{edit.subject}}" maxlength="30" data-field="subject" bindinput="editInput"/><view class="label">作业要求</view><textarea value="{{edit.content}}" maxlength="3000" data-field="content" bindinput="editInput"/><view class="row"><view>优先任务</view><switch checked="{{edit.priority==='high'}}" bindchange="editPriority"/></view><view class="label">截止日期（可留空）</view><input value="{{edit.dueDate}}" placeholder="YYYY-MM-DD" data-field="dueDate" bindinput="editInput"/><view class="label">准备材料</view><input value="{{edit.materials}}" maxlength="500" data-field="materials" bindinput="editInput"/><view class="muted">修改后取消完成状态，请孩子重新确认。</view></view><view class="bottom-dock" style="bottom:{{keyboard}}px"><button class="primary" bindtap="saveEdit" disabled="{{busy}}">保存修改</button></view></block>
</view>