<view class="page dock-page">
<block wx:if="{{!edit&&!composing}}">
 <view class="row compact-top"><picker range="{{children}}" range-key="name" value="{{index}}" bindchange="child"><view>{{children[index].name || '请添加孩子'}} ▾</view></picker><picker mode="date" value="{{date}}" bindchange="dateChange"><view>{{date}}</view></picker><view class="link" bindtap="more">更多</view></view>
 <scroll-view wx:if="{{subjects.length>1}}" scroll-x class="subject-tabs"><view class="subject-tab {{!subject?'active':''}}" data-subject="" bindtap="selectSubject">全部 {{assignments.length}}</view><view wx:for="{{subjects}}" wx:key="subject" class="subject-tab {{subject===item.subject?'active':''}}" data-subject="{{item.subject}}" bindtap="selectSubject">{{item.subject}} {{item.count}}</view></scroll-view>
 <view wx:if="{{current}}" class="row"><view>{{current.label}}</view><view class="link" bindtap="review">查看结果</view></view>
 <view class="row"><view class="heading">已有作业 {{assignments.length}}</view><view class="row"><view class="muted">所有未完成</view><switch checked="{{pending}}" bindchange="pendingChange" color="#315f53"/></view></view>
 <view wx:if="{{!assignments.length}}" class="empty">暂无作业，点击底部“新增任务”。</view>
 <view wx:for="{{visibleAssignments}}" wx:key="id" class="card compact-card"><view class="badge">{{item.subject}} {{item.priority==='high'?'· 优先':''}}</view><view wx:if="{{item.updated}}" class="warning">内容有更新</view><view class="content {{item.completed?'complete':''}}">{{item.content}}</view><view wx:if="{{item.materials}}" class="muted">准备：{{item.materials}}</view><view class="muted">{{item.completed?'已完成':'待完成'}} {{item.due_date?'· 截止 '+item.due_date:''}}</view><view class="task-actions"><button data-index="{{item.sourceIndex}}" bindtap="toggle" disabled="{{busy}}">{{item.completed?'取消完成':'标记完成'}}</button><button data-index="{{item.sourceIndex}}" bindtap="editTask" disabled="{{busy}}">详情 / 编辑</button><button data-index="{{item.sourceIndex}}" bindtap="remove" disabled="{{busy}}">删除</button></view></view>
 <view class="bottom-dock"><button class="primary" bindtap="openComposer" disabled="{{busy||!children.length}}">新增任务</button></view>
</block>
<block wx:elif="{{composing}}"><view class="row"><view class="heading">新增任务</view><button bindtap="closeComposer" disabled="{{busy}}">关闭</button></view><view class="card"><picker mode="date" value="{{date}}" bindchange="dateChange"><view>作业日期 {{date}}</view></picker><view wx:if="{{children.length>1}}" class="link" bindtap="expand">分配孩子（{{childIds.length}}） {{expanded?'收起':'展开'}}</view><checkbox-group wx:if="{{expanded}}" bindchange="childChange"><label wx:for="{{children}}" wx:key="id" class="check"><checkbox value="{{item.id}}" checked="{{childFlags[item.id] || false}}" color="#315f53"/>{{item.name}}</label></checkbox-group><textarea value="{{text}}" bindinput="textInput" bindkeyboardheightchange="keyboardChange" bindblur="blur" adjust-position="{{false}}" maxlength="50000" placeholder="输入或粘贴作业；直接录入将整段原文作为一项任务"/><view class="row"><button bindtap="images" disabled="{{files.length>=5}}">添加截图</button><button bindtap="files" disabled="{{files.length>=5}}">从微信聊天选择文件</button></view><view wx:for="{{files}}" wx:key="path" class="row"><text class="file-name">{{item.name}}</text><text class="link" data-index="{{index}}" bindtap="removeFile">移除</text></view><view class="muted">直接录入整段保留为一项（最多3000字）。附件由 Kimi 处理，最多5个、每个8MB。</view></view><view class="bottom-dock" style="bottom:{{keyboard}}px"><button bindtap="submit" data-ai="false" disabled="{{busy||!childIds.length||!hasText||text.length>3000||files.length>0}}">直接录入</button><button class="primary" bindtap="submit" data-ai="true" disabled="{{busy||!childIds.length||(!hasText&&!files.length)}}">交给 Kimi 整理</button></view></block>
<block wx:else><view class="row"><view class="heading">编辑作业</view><view class="link" bindtap="closeEdit">关闭</view></view><view class="card"><view class="label">学科</view><picker range="{{editSubjectOptions}}" value="{{editSubjectIndex}}" bindchange="editSubject"><view class="subject-picker">{{edit.subject==='待确认'?'请选择科目':edit.subject}} ▾</view></picker><view class="label">作业要求</view><textarea value="{{edit.content}}" maxlength="3000" data-field="content" bindinput="editInput"/><view class="row"><view>优先任务</view><switch checked="{{edit.priority==='high'}}" bindchange="editPriority"/></view><view class="label">截止日期（可留空）</view><input value="{{edit.dueDate}}" placeholder="YYYY-MM-DD" data-field="dueDate" bindinput="editInput"/><view class="label">准备材料</view><input value="{{edit.materials}}" maxlength="500" data-field="materials" bindinput="editInput"/><view class="muted">修改后取消完成状态，请孩子重新确认。</view></view><view class="bottom-dock" style="bottom:{{keyboard}}px"><button class="primary" bindtap="saveEdit" disabled="{{busy}}">保存修改</button></view></block>
</view>