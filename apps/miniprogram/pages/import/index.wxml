<view class="page"><view class="heading">导入记录</view><view wx:if="{{!imports.length}}" class="empty">{{busy?'加载中…':'暂无记录'}}</view><view wx:for="{{imports}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="review"><view class="row"><text>{{item.work_date}}</text><text class="badge">{{item.label}}</text></view><view class="content">{{item.source_text || '图片消息'}}</view><view wx:if="{{item.error}}" class="warning">{{item.error}}</view><view class="link">查看 / 审核</view></view></view>