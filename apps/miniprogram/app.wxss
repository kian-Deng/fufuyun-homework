page{background:#f5f7f8;color:#233b36;font-size:30rpx;line-height:1.6;font-family:-apple-system,sans-serif}.page{padding:32rpx}.title{font-size:48rpx;font-weight:700;margin:16rpx 0}.sub{color:#71847c;font-size:26rpx;margin-bottom:28rpx}.card{background:#fff;padding:28rpx;border-radius:24rpx;margin-bottom:24rpx;border:1rpx solid #e2eae4}.heading{font-size:34rpx;font-weight:600;margin-bottom:20rpx}.primary{background:#315f53!important;color:white!important}.muted{color:#71847c;font-size:26rpx}.warning{color:#a34d2f;background:#fff1e9;padding:16rpx;border-radius:12rpx;margin:12rpx 0}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:18rpx}.badge{color:#315f53;background:#eaf2ed;border-radius:10rpx;padding:6rpx 16rpx;font-size:24rpx}button{font-size:28rpx;border-radius:16rpx;margin:14rpx 0}button:after{border:0}input,textarea{background:#f5f8f5;border:1rpx solid #dce6de;border-radius:14rpx;padding:20rpx;margin:12rpx 0 22rpx;box-sizing:border-box;width:100%}textarea{height:240rpx}.label{font-size:26rpx;color:#62776b}.check{display:inline-flex;align-items:center;gap:8rpx;margin:12rpx 20rpx 12rpx 0}.content{white-space:pre-wrap;font-size:32rpx}.complete{color:#7b8c82;text-decoration:line-through}.code{font-size:48rpx;letter-spacing:4rpx;font-weight:700;padding:24rpx 0}.divider{border-top:1rpx solid #e3ebe5;margin:26rpx 0}.link{color:#315f53;padding:14rpx 0}.empty{text-align:center;padding:50rpx 20rpx;color:#7b8c82}

.dock-page{padding-bottom:calc(180rpx + env(safe-area-inset-bottom))}.compact-top{gap:12rpx;font-size:28rpx}.compact-card{padding:22rpx}.compact-card textarea{margin-bottom:8rpx}.mode-tabs{display:flex;gap:12rpx;margin-bottom:14rpx}.mode-tabs button{flex:1;margin:0;font-size:28rpx}.bottom-dock{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1rpx solid #dce6df;padding:14rpx 28rpx calc(14rpx + env(safe-area-inset-bottom));z-index:5}.bottom-dock button{margin:0}.task-actions{display:flex;gap:8rpx;flex-wrap:wrap;border-top:1rpx solid #edf1ed;margin-top:16rpx}.task-actions button{padding:0 12rpx;font-size:26rpx;background:transparent;margin:4rpx 0}.file-name{min-width:0;overflow-wrap:anywhere}.content{overflow-wrap:anywhere;margin:14rpx 0}.heading{margin-bottom:0}.row>button{flex:1;font-size:25rpx;padding:0 10rpx}

.bottom-dock{display:flex;gap:16rpx}.bottom-dock button{flex:1}.dock-page{padding-bottom:calc(200rpx + env(safe-area-inset-bottom))}

.subject-tabs{white-space:nowrap;margin:8rpx 0 20rpx;width:100%}.subject-tab{display:inline-block;padding:16rpx 24rpx;background:#edf3ef;border-radius:16rpx;margin-right:12rpx;font-size:28rpx}.subject-tab.active{background:#315f53;color:#fff}

.subject-picker{background:#f5f8f5;border:1rpx solid #dce6de;border-radius:14rpx;padding:20rpx;margin:12rpx 0 22rpx}.household-description{white-space:pre-wrap;overflow-wrap:anywhere}

.hh-tabs{display:flex;background:#e9efeb;border-radius:20rpx;padding:8rpx;gap:8rpx;margin:0 0 24rpx}.hh-tabs button{flex:1;margin:0;background:transparent;padding:0 10rpx;font-size:28rpx;transition:background .15s ease}.hh-tabs button.hh-active{background:white;box-shadow:0 3rpx 12rpx #233b3610}.hh-tab-content{animation:hh-tab .15s ease}.hh-mask{position:fixed;inset:0;background:#172f2a99;z-index:20;animation:hh-fade .2s ease}.hh-sheet{position:absolute;bottom:0;left:0;right:0;background:white;border-radius:32rpx 32rpx 0 0;padding:24rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));animation:hh-slide .22s ease}.hh-sheet-scroll{width:100%}.hh-sheet-actions button{margin:18rpx 0 0}.hh-closing{animation:hh-out .18s ease forwards}.hh-closing .hh-sheet{animation:hh-down .18s ease forwards}.hh-task-select{align-items:flex-start;max-width:100%}.hh-task-select .household-description{min-width:0}.hh-toast{position:fixed;left:28rpx;right:28rpx;top:20rpx;z-index:30;background:#315f53;color:white;padding:24rpx;border-radius:20rpx;box-shadow:0 8rpx 32rpx #233b3620;animation:hh-tab .18s ease}button:active{transform:scale(.98)}@keyframes hh-fade{from{opacity:0}to{opacity:1}}@keyframes hh-out{to{opacity:0}}@keyframes hh-slide{from{transform:translateY(80rpx)}to{transform:none}}@keyframes hh-down{to{transform:translateY(80rpx)}}@keyframes hh-tab{from{opacity:0;transform:translateY(8rpx)}to{opacity:1;transform:none}}@media(prefers-reduced-motion:reduce){.hh-mask,.hh-sheet,.hh-closing,.hh-closing .hh-sheet,.hh-tab-content,.hh-toast{animation:none}.hh-tabs button{transition:none}button:active{transform:none}}
